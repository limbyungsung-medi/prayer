{
  "id": "./?app=swgido-2",
  "name": "쉬지 않는 기도",
  "short_name": "쉬지않는기도",
  "description": "개인 기도노트 — 요일 순환 중보기도, 응답 기록, 말씀 적용",
  "lang": "ko",
  "start_url": "./?app=swgido&v=2",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone"
  ],
  "orientation": "any",
  "background_color": "#0E1330",
  "theme_color": "#0E1330",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "file",
          "accept": [
            "text/x-vcard",
            "text/vcard",
            "text/directory",
            ".vcf",
            ".vcard",
            "text/plain"
          ]
        }
      ]
    }
  }
}